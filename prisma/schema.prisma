generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// User & Authentication
// ============================================================================

// User model for storing local user data linked to core-api
model User {
  id    String @id // User ID from core-api
  token String @unique @default(uuid()) // API token for service authentication

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  requestsCreated         Request[]          @relation("RequestCreatedBy")
  requestDatasetsApproved RequestDataset[]   @relation("DatasetApprovedBy")
  requestServicesApproved RequestService[]   @relation("ServiceApprovedBy")
  requestReportsApproved  RequestReport[]    @relation("ReportApprovedBy")
  serviceLogs             UserServiceLog[]

  @@map("users")
}

// ============================================================================
// Master Data
// ============================================================================

// Unit Owner - หน่วยงานเจ้าของข้อมูล
model UnitOwner {
  id        String  @id @default(uuid())
  name      String
  shortName String  @map("short_name")
  icon      String? // File path to icon

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  datasets    Dataset[]
  reportUnits ReportUnitOwner[]

  @@map("unit_owners")
}

// Category - หมวดหมู่ข้อมูล
model Category {
  id        String  @id @default(uuid())
  name      String
  shortName String  @map("short_name")
  icon      String? // File path to icon
  order     Int     @default(0) // Display order

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  datasets          Dataset[]
  datasetCategories DatasetCategory[]
  reports           Report[]
  reportCategories  ReportCategory[]

  @@map("categories")
}

// DatasetType - ประเภทข้อมูล
model DatasetType {
  id        String  @id @default(uuid())
  name      String
  shortName String  @map("short_name")

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  datasets Dataset[]

  @@map("dataset_types")
}

// Dataset - ชุดข้อมูล
model Dataset {
  id            String  @id @default(uuid())
  name          String
  code          String
  detail        String? @db.Text
  unitOwnerId   String  @map("unit_owner_id")
  categoryId    String  @map("category_id") // Keep for backward compatibility
  typeId        String  @map("type_id")
  securityLevel String? @map("security_level") // เปิด | ลับ | ลับมาก | ลับที่สุด
  metadata      String? // File path to metadata document
  datadict      String? // File path to data dictionary document

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  unitOwner           UnitOwner               @relation(fields: [unitOwnerId], references: [id])
  category            Category                @relation(fields: [categoryId], references: [id]) // Keep for backward compatibility
  type                DatasetType             @relation(fields: [typeId], references: [id])
  categories          DatasetCategory[]       // New m:m relation
  services            Service[]
  requestDatasets     RequestDataset[]
  reportDatasets      ReportDataset[]
  requestReportDatasets RequestReportDataset[]

  @@map("datasets")
}

// Service - บริการข้อมูล
model Service {
  id        String @id @default(uuid())
  name      String
  detail    String? @db.Text
  datasetId String  @map("dataset_id")
  method    String // GET, POST, PATCH
  api       String
  howTo     String? @map("how_to") // File path to how-to document

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  dataset         Dataset            @relation(fields: [datasetId], references: [id])
  requestServices RequestService[]
  serviceLogs     UserServiceLog[]

  @@map("services")
}

// ============================================================================
// Request Management
// ============================================================================

// Request - คำร้องขอใช้ข้อมูล
model Request {
  id          String  @id @default(uuid())
  requestedBy String  @map("requested_by") // User ID
  name        String  // ชื่อผู้ส่งคำร้องขอ
  unit        String  // หน่วยงานผู้ส่งคำร้องขอ
  email       String  // เมล์ผู้ส่งคำร้องขอ
  tel         String  // เบอร์โทรผู้ส่งคำร้องขอ
  detail      String? @db.Text // รายละเอียดคำร้องขอเพิ่มเติม

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  requester       User             @relation("RequestCreatedBy", fields: [requestedBy], references: [id])
  requestDatasets RequestDataset[]
  requestServices RequestService[]
  requestReports  RequestReport[]
  requestFiles    RequestFile[]

  @@map("requests")
}

// RequestDataset - คำร้องขอ dataset
model RequestDataset {
  id            String   @id @default(uuid())
  requestId     String   @map("request_id")
  datasetId     String   @map("dataset_id")
  approveStatus String   @default("REQUESTED") @map("approve_status") // REQUESTED | PENDING | APPROVED | DISAPPROVED
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  comment       String?  @db.Text

  // Relations
  request  Request  @relation(fields: [requestId], references: [id])
  dataset  Dataset  @relation(fields: [datasetId], references: [id])
  approver User?    @relation("DatasetApprovedBy", fields: [approvedBy], references: [id])
  approvalFiles RequestDatasetApprovalFile[]

  @@map("request_datasets")
}

// RequestService - คำร้องขอ service
model RequestService {
  id            String   @id @default(uuid())
  requestId     String   @map("request_id")
  serviceId     String   @map("service_id")
  approveStatus String   @default("REQUESTED") @map("approve_status") // REQUESTED | PENDING | APPROVED | DISAPPROVED
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  comment       String?  @db.Text

  // Relations
  request  Request  @relation(fields: [requestId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  approver User?    @relation("ServiceApprovedBy", fields: [approvedBy], references: [id])
  approvalFiles RequestServiceApprovalFile[]

  @@map("request_services")
}

// RequestFile - ไฟล์แนบคำร้องขอ
model RequestFile {
  id        String @id @default(uuid())
  requestId String @map("request_id")
  filePath  String @map("file_path")
  fileName  String @map("file_name")
  fileType  String @map("file_type")
  fileSize  Int    @map("file_size")

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  request Request @relation(fields: [requestId], references: [id])

  @@map("request_files")
}

// RequestDatasetApprovalFile - ไฟล์แนบการอนุมัติ dataset
model RequestDatasetApprovalFile {
  id               String   @id @default(uuid())
  requestDatasetId String   @map("request_dataset_id")
  filePath         String   @map("file_path")
  fileName         String   @map("file_name")
  fileType         String   @map("file_type")
  fileSize         Int      @map("file_size")

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  requestDataset RequestDataset @relation(fields: [requestDatasetId], references: [id])

  @@map("request_dataset_approval_files")
}

// RequestServiceApprovalFile - ไฟล์แนบการอนุมัติ service
model RequestServiceApprovalFile {
  id               String   @id @default(uuid())
  requestServiceId String   @map("request_service_id")
  filePath         String   @map("file_path")
  fileName         String   @map("file_name")
  fileType         String   @map("file_type")
  fileSize         Int      @map("file_size")

  // Audit fields
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  // Relations
  requestService RequestService @relation(fields: [requestServiceId], references: [id])

  @@map("request_service_approval_files")
}

// ============================================================================
// Service Usage Tracking
// ============================================================================

// UserServiceLog - บันทึกการใช้งาน service ของ user
model UserServiceLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  serviceId String   @map("service_id")
  requestIp String?  @map("request_ip") // IP address ของผู้ใช้
  userAgent String?  @map("user_agent") // User agent ของผู้ใช้

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([serviceId])
  @@index([createdAt])
  @@map("user_service_logs")
}

// ============================================================================
// Many-to-Many Junction Tables
// ============================================================================

// DatasetCategory - Junction table for Dataset and Category (m:m)
model DatasetCategory {
  id         String   @id @default(uuid())
  datasetId  String   @map("dataset_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  dataset  Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([datasetId, categoryId])
  @@index([datasetId])
  @@index([categoryId])
  @@map("dataset_categories")
}

// ============================================================================
// Notification Management
// ============================================================================

// UserNotificationRead - บันทึกการอ่าน notification ของ user สำหรับ dataset/service
model UserNotificationRead {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  requestDatasetId String?   @map("request_dataset_id")
  requestServiceId String?   @map("request_service_id")
  lastReadAt       DateTime  @default(now()) @map("last_read_at")

  // Audit fields
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, requestDatasetId])
  @@unique([userId, requestServiceId])
  @@index([userId])
  @@map("user_notification_reads")
}

// ============================================================================
// Report Management  
// ============================================================================

// ReportType - ประเภทรายงาน (document, infographic, dashboard)
model ReportType {
  id        String  @id @default(uuid())
  name      String
  shortName String  @map("short_name")

  // Audit fields
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedBy  String?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  reports Report[]

  @@map("report_types")
}

// Report - รายงาน
model Report {
  id            String  @id @default(uuid())
  name          String
  detail        String? @db.Text
  typeId        String  @map("type_id")
  url           String?
  categoryId    String  @map("category_id") // Keep for backward compatibility
  securityLevel String? @map("security_level") // เปิด | ลับ | ลับมาก | ลับที่สุด

  // Audit fields
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedBy  String?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  type            ReportType         @relation(fields: [typeId], references: [id])
  category        Category           @relation(fields: [categoryId], references: [id]) // Keep for backward compatibility
  categories      ReportCategory[]   // m:m with Category
  datasets        ReportDataset[]    // m:m with Dataset
  unitOwners      ReportUnitOwner[]  // m:m with UnitOwner (involved units)
  files           ReportFile[]
  requestReports  RequestReport[]

  @@map("reports")
}

// ReportCategory - Junction table Report-Category (m:m)
model ReportCategory {
  id         String   @id @default(uuid())
  reportId   String   @map("report_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  report   Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([reportId, categoryId])
  @@index([reportId])
  @@index([categoryId])
  @@map("report_categories")
}

// ReportDataset - Junction table Report-Dataset (m:m)
model ReportDataset {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  datasetId String   @map("dataset_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([reportId, datasetId])
  @@index([reportId])
  @@index([datasetId])
  @@map("report_datasets")
}

// ReportUnitOwner - Junction table Report-UnitOwner (m:m for involved units)
model ReportUnitOwner {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  unitOwnerId String   @map("unit_owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  unitOwner UnitOwner @relation(fields: [unitOwnerId], references: [id], onDelete: Cascade)

  @@unique([reportId, unitOwnerId])
  @@index([reportId])
  @@index([unitOwnerId])
  @@map("report_unit_owners")
}

// ReportFile - ไฟล์รายงาน (multiple files support)
model ReportFile {
  id       String @id @default(uuid())
  reportId String @map("report_id")
  filePath String @map("file_path")
  fileName String @map("file_name")
  fileType String @map("file_type")
  fileSize Int    @map("file_size")

  // Audit fields
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedBy  String?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_files")
}

// RequestReport - คำร้องขอรายงาน (ทั้งรายงานที่มีอยู่และรายงานใหม่)
model RequestReport {
  id            String    @id @default(uuid())
  requestId     String    @map("request_id")
  reportId      String?   @map("report_id") // null = ร้องขอรายงานใหม่ที่ยังไม่มีในระบบ
  approveStatus String    @default("REQUESTED") @map("approve_status") // REQUESTED | PENDING | APPROVED | DISAPPROVED
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  comment       String?   @db.Text

  // Fields for new report request (when reportId is null)
  title  String? // ชื่อรายงานที่ต้องการ
  detail String? @db.Text // รายละเอียดเพิ่มเติม

  // Relations
  request           Request                     @relation(fields: [requestId], references: [id])
  report            Report?                     @relation(fields: [reportId], references: [id])
  approver          User?                       @relation("ReportApprovedBy", fields: [approvedBy], references: [id])
  designFiles       RequestReportDesignFile[]   // ไฟล์ design ที่แนบมา
  selectedDatasets  RequestReportDataset[]      // datasets ที่ใช้ในรายงาน
  approvalFiles     RequestReportApprovalFile[] // ไฟล์การอนุมัติ

  @@map("request_reports")
}

// RequestReportDesignFile - ไฟล์ design สำหรับรายงานใหม่
model RequestReportDesignFile {
  id              String   @id @default(uuid())
  requestReportId String   @map("request_report_id")
  filePath        String   @map("file_path")
  fileName        String   @map("file_name")
  fileType        String   @map("file_type")
  fileSize        Int      @map("file_size")

  // Audit fields
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedBy  String?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  requestReport RequestReport @relation(fields: [requestReportId], references: [id])

  @@map("request_report_design_files")
}

// RequestReportDataset - Junction table สำหรับ datasets ที่ใช้ในรายงาน
model RequestReportDataset {
  id              String   @id @default(uuid())
  requestReportId String   @map("request_report_id")
  datasetId       String   @map("dataset_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  requestReport RequestReport @relation(fields: [requestReportId], references: [id])
  dataset       Dataset       @relation(fields: [datasetId], references: [id])

  @@unique([requestReportId, datasetId])
  @@map("request_report_datasets")
}

// RequestReportApprovalFile - ไฟล์แนบการอนุมัติรายงาน
model RequestReportApprovalFile {
  id              String   @id @default(uuid())
  requestReportId String   @map("request_report_id")
  filePath        String   @map("file_path")
  fileName        String   @map("file_name")
  fileType        String   @map("file_type")
  fileSize        Int      @map("file_size")

  // Audit fields
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedBy  String?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  requestReport RequestReport @relation(fields: [requestReportId], references: [id])

  @@map("request_report_approval_files")
}
